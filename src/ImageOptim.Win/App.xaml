<Application x:Class="ImageOptim.Win.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Mutable brushes: ThemeManager updates their Color on a system theme event. -->
        <SolidColorBrush x:Key="ThemeWindow" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThemeTitleBar" Color="#F2F2F3"/>
        <SolidColorBrush x:Key="ThemeHeader" Color="#F7F7F8"/>
        <SolidColorBrush x:Key="ThemeFooter" Color="#F5F5F6"/>
        <SolidColorBrush x:Key="ThemeBorder" Color="#D7D8DC"/>
        <SolidColorBrush x:Key="ThemeText" Color="#24252A"/>
        <SolidColorBrush x:Key="ThemeSecondaryText" Color="#676970"/>
        <SolidColorBrush x:Key="ThemeMutedText" Color="#96989D"/>
        <SolidColorBrush x:Key="ThemeStripe" Color="#F6F6F7"/>
        <SolidColorBrush x:Key="ThemeSelected" Color="#DCEAFE"/>
        <SolidColorBrush x:Key="ThemeSelectedText" Color="#24252A"/>
        <SolidColorBrush x:Key="ThemeButton" Color="#F8F8F9"/>
        <SolidColorBrush x:Key="ThemeButtonHover" Color="#E8E9EC"/>
        <SolidColorBrush x:Key="ThemeProgressTrack" Color="#DADDE1"/>
        <SolidColorBrush x:Key="ThemeProgressFill" Color="#1680F2"/>
        <SolidColorBrush x:Key="ThemeInput" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThemeDialog" Color="#F7F7F8"/>
        <SolidColorBrush x:Key="ThemeStatusDone" Color="#16A34A"/>
        <SolidColorBrush x:Key="ThemeStatusRunning" Color="#2B7CD6"/>
        <SolidColorBrush x:Key="ThemeStatusFailed" Color="#D53D45"/>

        <Style x:Key="RightAlignedText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="MacCircle" TargetType="Button">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" CornerRadius="8"
                                Background="{TemplateBinding Background}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FooterButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeButton}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="{DynamicResource ThemeButtonHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
