<Window x:Class="ImageOptim.Win.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/AppIcon.png"
        Title="软件更新" Width="440" Height="236" MinWidth="420" MinHeight="236"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        Foreground="{DynamicResource ThemeText}" Background="{DynamicResource ThemeWindow}"
        Closing="Window_Closing">
    <Border Background="{DynamicResource ThemeWindow}" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Text="发现新版本"/>
            <TextBlock x:Name="VersionText" Grid.Row="1" Margin="0,12,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource ThemeSecondaryText}"/>
            <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,12,0,4" Text="下载后校验数字签名和 SHA-256。"
                       TextWrapping="Wrap"/>
            <ProgressBar x:Name="DownloadProgress" Grid.Row="3" Minimum="0" Maximum="100"
                         Height="9" Margin="0,4,0,0" VerticalAlignment="Top" Visibility="Collapsed"/>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="CancelButton" Click="Cancel_Click" Content="以后再说" Width="88" Height="30" Margin="0,0,8,0"/>
                <Button x:Name="InstallButton" Click="Install_Click" Content="下载并安装" Width="112" Height="30"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
