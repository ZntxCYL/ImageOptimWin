<Window x:Class="ImageOptim.Win.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/AppIcon.png"
        Title="ImageOptim 偏好设置" Width="705" Height="580" MinWidth="650" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource ThemeDialog}" Foreground="{DynamicResource ThemeText}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeFooter}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBackground" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                                CornerRadius="5,5,0,0" Padding="15,8" Margin="0,0,3,0">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBackground" Property="Background" Value="{DynamicResource ThemeWindow}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeInput}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeInput}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeInput}"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>
        <TabControl Grid.Row="0" Background="{DynamicResource ThemeDialog}"
                    Foreground="{DynamicResource ThemeText}" BorderThickness="0">
            <TabItem Header="通用">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Background="{DynamicResource ThemeWindow}">
                    <Grid Margin="12,18,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="205"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <GroupBox Grid.Column="0" Header="启用压缩引擎" Margin="0,0,12,0">
                            <StackPanel Margin="10,8,6,12">
                                <CheckBox Content="OxiPNG" IsChecked="{Binding UseOxipng}" Margin="0,6"/>
                                <CheckBox Content="pngquant（有损）" IsChecked="{Binding UsePngquant}" Margin="0,6"/>
                                <CheckBox Content="JPEGOptim" IsChecked="{Binding UseJpegoptim}" Margin="0,6"/>
                                <CheckBox Content="Jpegtran" IsChecked="{Binding UseJpegtran}" Margin="0,6"/>
                                <CheckBox Content="Gifsicle" IsChecked="{Binding UseGifsicle}" Margin="0,6"/>
                                <CheckBox Content="SVGO" IsChecked="{Binding UseSvgo}" Margin="0,6"/>
                            </StackPanel>
                        </GroupBox>
                        <StackPanel Grid.Column="1">
                            <GroupBox Header="界面外观" Margin="0,0,0,10">
                                <StackPanel Margin="9,8,9,10">
                                    <TextBlock Text="颜色主题" Margin="0,0,0,6"/>
                                    <ComboBox Width="170" HorizontalAlignment="Left" Height="27"
                                              SelectedValuePath="Tag" SelectedValue="{Binding ThemeMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBoxItem Content="跟随 Windows 系统" Tag="System"/>
                                        <ComboBoxItem Content="浅色模式" Tag="Light"/>
                                        <ComboBoxItem Content="深色模式" Tag="Dark"/>
                                    </ComboBox>
                                    <TextBlock Text="跟随系统时，Windows 更换应用颜色后会自动同步，无需重启。"
                                               TextWrapping="Wrap" Foreground="{DynamicResource ThemeMutedText}"
                                               FontSize="11" Margin="0,7,0,0"/>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="元数据与颜色配置" Margin="0,0,0,10">
                                <StackPanel Margin="9,8,8,10">
                                    <CheckBox Content="清除 PNG 可安全移除的元数据"
                                              IsChecked="{Binding StripPngMetadata}" Margin="0,4"/>
                                    <CheckBox Content="清除 JPEG 元数据（EXIF、GPS、色彩配置等）"
                                              IsChecked="{Binding StripJpegMetadata}" Margin="0,4"/>
                                    <TextBlock Text="注意：清理元数据可能移除版权信息和颜色资料。"
                                               TextWrapping="Wrap" Foreground="{DynamicResource ThemeMutedText}"
                                               FontSize="11" Margin="22,4,0,0"/>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="文件处理" Margin="0,0,0,10">
                                <StackPanel Margin="9,8,8,10">
                                    <CheckBox Content="保留文件创建与修改时间" IsChecked="{Binding PreserveTimestamps}" Margin="0,4"/>
                                    <TextBlock Text="仅在结果更小时替换源文件。恢复原图仅在本次运行期间有效。"
                                               Foreground="{DynamicResource ThemeMutedText}" FontSize="11"
                                               TextWrapping="Wrap" Margin="22,4,0,0"/>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Windows 压缩工具位置（高级）">
                                <StackPanel Margin="9,8,9,10">
                                    <TextBlock Text="发布版已内置压缩器。一般无需手动指定，仅供高级用户覆盖目录。"
                                               Foreground="{DynamicResource ThemeSecondaryText}" FontSize="11" TextWrapping="Wrap"/>
                                    <DockPanel Margin="0,7,0,0">
                                        <Button DockPanel.Dock="Right" Content="浏览…" Width="72" Height="26"
                                                Style="{StaticResource FooterButton}" Margin="7,0,0,0" Click="BrowseTools_Click"/>
                                        <TextBox x:Name="ToolsPathBox" Text="{Binding ToolsDirectory, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalContentAlignment="Center" Height="26"/>
                                    </DockPanel>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="画质">
                <StackPanel Margin="29,29,29,0">
                    <CheckBox Content="启用有损压缩" FontWeight="SemiBold" IsChecked="{Binding EnableLossy}"/>
                    <TextBlock Foreground="{DynamicResource ThemeSecondaryText}" TextWrapping="Wrap" Margin="22,8,0,25"
                               Text="有损 JPEG / PNG 会改变像素。关闭时仅使用无损压缩引擎。"/>
                    <TextBlock Text="JPEG 画质" FontWeight="SemiBold"/>
                    <DockPanel Margin="0,9,0,24">
                        <TextBlock DockPanel.Dock="Right" Width="54" TextAlignment="Right"
                                   Text="{Binding ElementName=JpegSlider, Path=Value, StringFormat={}{0:F0}%}"/>
                        <Slider x:Name="JpegSlider" Minimum="40" Maximum="100" TickFrequency="1"
                                IsSnapToTickEnabled="True" Value="{Binding JpegQuality, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <TextBlock Text="PNG 画质" FontWeight="SemiBold"/>
                    <DockPanel Margin="0,9,0,12">
                        <TextBlock DockPanel.Dock="Right" Width="54" TextAlignment="Right"
                                   Text="{Binding ElementName=PngSlider, Path=Value, StringFormat={}{0:F0}%}"/>
                        <Slider x:Name="PngSlider" Minimum="40" Maximum="100" TickFrequency="1"
                                IsSnapToTickEnabled="True" Value="{Binding PngQuality, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <TextBlock Text="当前版本暂不提供 GIF 有损压缩。"
                               Foreground="{DynamicResource ThemeMutedText}" FontSize="11" Margin="0,16,0,0"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="优化等级">
                <StackPanel Margin="29,31,29,0">
                    <TextBlock Text="选择图片压缩时的优化强度" FontWeight="SemiBold"/>
                    <TextBlock Text="OxiPNG 等级越高耗时通常越长；其他引擎使用各自的优化模式。"
                               TextWrapping="Wrap" Foreground="{DynamicResource ThemeSecondaryText}" Margin="0,10,0,30"/>
                    <Slider x:Name="LevelSlider" Minimum="1" Maximum="3" TickFrequency="1"
                            TickPlacement="BottomRight" IsSnapToTickEnabled="True"
                            Value="{Binding OptimizationLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="快速"/>
                        <TextBlock Grid.Column="1" Text="均衡" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="充分" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </TabItem>
            <TabItem Header="关于">
                <StackPanel Margin="29,29,29,0">
                    <TextBlock Text="ImageOptimWin" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionText" Margin="0,12,0,0" FontSize="13"
                               Foreground="{DynamicResource ThemeText}"/>
                    <TextBlock Text="Windows x64 · C# WPF" Margin="0,8,0,0"
                               Foreground="{DynamicResource ThemeSecondaryText}"/>
                    <TextBlock Text="非官方 Windows 图片优化工具。更新由 GitHub Releases 提供，安装前验证数字签名和文件校验值。"
                               TextWrapping="Wrap" Margin="0,20,0,0"
                               Foreground="{DynamicResource ThemeSecondaryText}"/>
                    <TextBlock Text="项目地址：github.com/ZntxCYL/ImageOptimWin"
                               Margin="0,14,0,0" Foreground="{DynamicResource ThemeSecondaryText}"/>
                </StackPanel>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="取消" Width="90" Height="29" Margin="0,0,9,0"
                    Style="{StaticResource FooterButton}" IsCancel="True"/>
            <Button Content="保存" Width="90" Height="29" Style="{StaticResource FooterButton}"
                    Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
